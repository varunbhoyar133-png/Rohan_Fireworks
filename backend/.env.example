# Rohan Fireworks Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local connection URI
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/rohan_fireworks?retryWrites=true&w=majority
# If omitted or unavailable during local dev, an in-memory Mongo engine starts automatically.
MONGODB_URI=mongodb://localhost:27017/rohan_fireworks

# JWT Authentication Secret
JWT_SECRET=rohan_fireworks_super_secret_jwt_key_2026_festive

# Allowed Frontend Origins (comma-separated)
CLIENT_URL=http://localhost:5173,http://localhost:3000

# Optional Cloudinary Configuration for Image Hosting in Production
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
